{
 "schema_version": 1,
 "engines": [
  {
   "language": "go",
   "image": "a2dlc-engine-bb-go:0.2",
   "paths": [
    "cmd/**",
    "internal/**",
    "go.mod"
   ],
   "budget": {
    "examples": 100,
    "seed": 1
   },
   "memory": "2g"
  }
 ],
 "out_of_scope_paths": [
  "conformance/**",
  "contracts/**",
  "e2e/**",
  "engines/blackbox/**",
  "engines/fake/**",
  "engines/php/**",
  "engines/ts/**",
  "engines/z3/**",
  "examples/**",
  "roles/**",
  "scripts/**",
  "templates/**",
  "tools/**",
  "verifiers/**"
 ],
 "protected_paths": [
  "scripts/run_self_tests.py",
  "scripts/run_self_tests.sh"
 ],
 "tests": {
  "image": "ghcr.io/falsable/a2dlc-tests@sha256:dcc0e3a69098fd5b8481cc62b268a490cb54879daa4a561a79c11aa7fab4dc16",
  "paths": [
   "cmd/**/*_test.go",
   "internal/**/*_test.go",
   "engines/py/test_*.py",
   "scripts/test_*.py"
  ],
  "source_paths": [
   "engines/py/*.py"
  ],
  "command": "A2DLC_TESTS=\"${A2DLC_TESTS:-}\" A2DLC_CHANGED=\"${A2DLC_CHANGED:-}\" A2DLC_JUNIT=\"$A2DLC_JUNIT\" A2DLC_COVERAGE=\"$A2DLC_COVERAGE\" sh scripts/run_self_tests.sh --mode command",
  "baseline_command": "A2DLC_TESTS=\"${A2DLC_TESTS:-}\" A2DLC_CHANGED=\"${A2DLC_CHANGED:-}\" A2DLC_JUNIT=\"$A2DLC_JUNIT\" A2DLC_COVERAGE=\"$A2DLC_COVERAGE\" sh scripts/run_self_tests.sh --mode baseline",
  "tier0_command": "baseline",
  "timeout_s": 900
 }
}
