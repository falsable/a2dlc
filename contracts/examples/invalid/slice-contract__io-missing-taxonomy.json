{
 "schema_version": 1,
 "slice_id": "calc.media.v1",
 "source": "consensus",
 "functions": [
  {
   "name": "media",
   "signature": "def media(xs: list[float]) -> float",
   "pre": [
    "xs is a list of finite floats"
   ],
   "post": [
    "devuelve sum(xs) / len(xs)",
    "does not modify xs"
   ],
   "invariants": [
    "min(xs) <= media(xs) <= max(xs)"
   ],
   "errors": [
    {
     "condition": "xs empty",
     "raises": "ValueError"
    }
   ],
   "lemmas": [
    {
     "name": "lemma_media_nonneg",
     "postcondition": "result >= 0"
    }
   ]
  }
 ],
 "probes": [
  {
   "id": "BP-01",
   "description": "The mean of a single element is that element",
   "input": "media([2.5])",
   "expected": "2.5",
   "kind": "example"
  },
  {
   "id": "BP-02",
   "description": "An empty list is rejected (α and β diverged; the intent says \"there is no average of nothing\")",
   "input": "media([])",
   "expected": "raises ValueError",
   "kind": "negative",
   "assumption": "listas-vacias"
  },
  {
   "id": "BP-03",
   "description": "The order does not change the result beyond rounding error",
   "input": "xs: finite list[float], permutation p",
   "expected": "abs(media(xs) - media(p(xs))) <= 1e-9 * max(1, max(map(abs, xs)))",
   "kind": "property"
  },
  {
   "id": "BP-04",
   "description": "No rounding: consensus probe of the catalogue assumption rounding",
   "input": "media([0.1, 0.2])",
   "expected": "0.15000000000000002",
   "kind": "example",
   "assumption": "redondeo"
  }
 ],
 "assumptions": [
  {
   "id": "redondeo",
   "statement": "No rounding: the result is the IEEE 754 float of the division.",
   "source": "catalogue",
   "status": "accepted"
  },
  {
   "id": "listas-vacias",
   "statement": "An empty list is a caller error, not a 0.0.",
   "source": "catalogue",
   "status": "accepted"
  },
  {
   "id": "nan",
   "statement": "Does a NaN in xs propagate or get rejected?",
   "source": "specifier",
   "status": "open"
  }
 ],
 "pi_s": {
  "equivalence": "relaxed",
  "relaxations": [
   "float_tolerance:1e-9"
  ]
 },
 "io_contract": {
  "input_schema_ref": "schemas/media.in.json",
  "output_schema_ref": "schemas/media.out.json"
 },
 "invariants": [
  {
   "text": "the media of a list is between its minimum and maximum",
   "dsl": "min(xs) <= media(xs) <= max(xs)",
   "verification": "smt+pbt"
  }
 ]
}
