{
 "schema_version": 1,
 "slice_id": "calc.media.v1",
 "source": "specifier_alpha",
 "functions": [
  {
   "name": "media",
   "signature": "def media(xs: list[float]) -> float",
   "pre": [
    "xs is a list of finite floats"
   ],
   "post": [
    "devuelve sum(xs) / len(xs)",
    "does not modify xs"
   ],
   "invariants": [
    "min(xs) <= media(xs) <= max(xs)"
   ],
   "errors": [
    {
     "condition": "xs empty",
     "raises": "ValueError"
    }
   ]
  }
 ],
 "probes": [
  {
   "id": "BP-01",
   "description": "The mean of a single element is that element",
   "input": "media([2.5])",
   "expected": "2.5",
   "kind": "example"
  },
  {
   "id": "BP-02",
   "description": "An empty list is rejected",
   "input": "media([])",
   "expected": "raises ValueError",
   "kind": "negative"
  }
 ],
 "assumptions": [
  {
   "id": "redondeo",
   "statement": "No rounding: the result is the IEEE 754 float of the division.",
   "source": "catalogue",
   "status": "accepted"
  }
 ],
 "pi_s": {
  "equivalence": "relaxed",
  "relaxations": []
 }
}
