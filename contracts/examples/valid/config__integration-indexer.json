{
  "schema_version": 1,
  "engines": [
    { "language": "python", "image": "a2dlc-engine-py:0.4", "paths": ["src/**"], "budget": {} }
  ],
  "integration": {
    "consumers": [
      {
        "name": "billing-web",
        "image": "billing-web-contracts:2026.10",
        "contracts": ["api/openapi.yaml"],
        "command": "pact-verifier",
        "auto": true
      }
    ],
    "indexer": {
      "command": "python -m chronosgraph.tools.a2dlc_blast_radius",
      "max_depth": 3
    }
  }
}
