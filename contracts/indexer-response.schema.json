{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2dlc.local/contracts/indexer-response.schema.json",
  "title": "Code Graph Indexer response (ChronosGraph / AST blast radius)",
  "description": "Response from the Code Graph Indexer (ChronosGraph, AST / SCIP): discovered dependency edges, total impacted count, and per-file blast radius and risk rankings.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "defs.schema.json#/$defs/schema_version" },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 }
        },
        "required": ["from", "to"],
        "additionalProperties": false
      }
    },
    "blast_radius": {
      "type": "object",
      "properties": {
        "total_impacted": { "type": "integer", "minimum": 0 },
        "ranking": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "blast_radius": { "type": "integer", "minimum": 0 },
              "risk_score": { "type": "number", "minimum": 0 },
              "high_risk_functions": { "type": "integer", "minimum": 0 }
            },
            "required": ["file", "blast_radius", "risk_score", "high_risk_functions"],
            "additionalProperties": false
          }
        }
      },
      "required": ["total_impacted", "ranking"],
      "additionalProperties": false
    },
    "error": { "type": ["string", "null"] }
  },
  "required": ["schema_version", "edges"],
  "additionalProperties": false
}
