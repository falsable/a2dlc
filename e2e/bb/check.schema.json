{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2dlc.local/e2e/bb/check.schema.json",
  "title": "Input for the \"check\" surface of the black-box self-test",
  "description": "An instance describes a repo: which files change from the base to the working tree, which verdict each fake engine gives per file, the engine config (globs, and whether the engine answers, crashes or answers garbage), which targets have a waiver, and the max_files cap. e2e/bb/setup materializes it; e2e/bb/fakedocker stands in for docker. It covers the whole surface of config.json and waivers.json except signatures (no fixture keys in v1).",
  "type": "object",
  "properties": {
    "files": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "path": { "enum": ["src/a.ts", "src/b/c.ts", "src/b/d.py", "src/b/h/i.ts", "lib/e.py", "f.go", "docs/g.md"] },
          "change": { "enum": ["modify", "modify", "modify", "add", "delete"] },
          "verdict": { "enum": ["PASS", "PASS", "FAIL", "INCONCLUSIVE"] },
          "waived": { "type": "boolean" }
        },
        "required": ["path", "change", "verdict", "waived"]
      }
    },
    "engines": {
      "type": "array", "minItems": 0, "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "mode": { "enum": ["ok", "ok", "ok", "crash", "basura"] },
          "paths": {
            "type": "array", "minItems": 1, "maxItems": 3,
            "items": { "enum": ["**", "src/**", "src/*.ts", "src/**/*.ts", "**/*.py", "lib/*", "*.go", "src/b/*", "**/c.ts", "docs/**"] }
          }
        },
        "required": ["mode", "paths"]
      }
    },
    "max_files": { "type": "integer", "minimum": 0, "maximum": 4, "description": "0 = no cap" }
  },
  "required": ["files", "engines", "max_files"]
}
